{
  "name": "run-calc-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --ssr src/staticSite.tsx --outDir .ssr-temp && node scripts/build-static-site.mjs",
